# Scenara's Neon PostgreSQL (Pulse reads Scenara tables + owns pulse_* tables)
DATABASE_URL=postgresql+psycopg2://user:password@host/scenara_db

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS — comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:3000,https://pulse.scenara.app
